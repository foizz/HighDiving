# Supabase project credentials. Without these the app still runs, guest-only.
# Both values are safe in the browser: the anon key only grants what the
# row-level security policies in supabase/migrations allow.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics 4 measurement ID. Leave blank to turn analytics off entirely;
# when set, it still only loads after a visitor allows it.
VITE_GA_MEASUREMENT_ID=
