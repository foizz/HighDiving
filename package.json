{
  "name": "highdiving",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "data:fina": "node scripts/extract-fina.mjs",
    "data:rb-images": "node scripts/extract-rb-images.mjs",
    "data:rb": "node scripts/build-rb-table.mjs",
    "build:engine": "esbuild src/engine-entry.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/_shared/engine.js",
    "data:rules-text": "node scripts/build-rules-text.mjs",
    "data:results-seed": "node scripts/build-results-seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
